# Copy to .env and fill in. NEVER commit a real .env. No real AWS credentials belong in this file for shared repos — use IAM roles / Secrets Manager in deployment.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# Local default (no Docker): leave DATABASE_URL empty to use SQLite. Docker Compose sets the Postgres URL itself.
DATABASE_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
# AI provider: mock (default, no AWS needed) | bedrock
AI_PROVIDER=mock
# Only needed for AI_PROVIDER=bedrock. Use a model ID available in YOUR AWS account/region; access must be requested in the Bedrock console. No model ID is guaranteed.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_ID=
EMBEDDING_DIM=64
MAX_UPLOAD_MB=10
MAX_PAGES=200
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
# Operator-configured price estimate for cost reporting. 0 = unknown. Check current Bedrock pricing yourself; do not treat any number here as a current price.
COST_PER_1K_TOKENS_USD=0
DEMO_PASSWORD=DemoPass123!
POSTGRES_PASSWORD=copilot_dev_password
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE=
